# Copy to .env to override the compose defaults. Local lab credentials only; never reuse them anywhere else.
POSTGRES_PASSWORD=postgres-dev-only
MIGRATOR_PASSWORD=migrator-dev-only
APP_PASSWORD=app-dev-only
GRAFANA_ADMIN_PASSWORD=grafana-dev-only
# baseline = the configuration the "before" runs measured; hardened = all fixes (default)
LAB_PROFILE=hardened
