          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 0.25
              }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
      "description": "Red line: the 250 ms p99 objective. Quantiles are interpolated from histogram buckets; the SLI itself reads the 25/100/250 ms bucket boundaries exactly."
